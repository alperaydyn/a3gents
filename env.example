# ── Residential Proxy Configuration ──────────────────────────
# Uncomment and fill in ONE provider section below.
# The proxy MUST provide Turkish residential IPs for sahibinden.com.

# ── Option A: Bright Data (formerly Luminati) ────────────────
# Sign up: https://brightdata.com
# Use "Residential" zone, set country to Turkey (TR)
#PROXY_SERVER=http://brd.superproxy.io:22225
#PROXY_USERNAME=brd-customer-XXXXX-zone-residential-country-tr
#PROXY_PASSWORD=your_password

# ── Option B: SmartProxy ─────────────────────────────────────
# Sign up: https://smartproxy.com
# Use residential endpoints with TR targeting
#PROXY_SERVER=http://gate.smartproxy.com:7000
#PROXY_USERNAME=user-XXXXX-country-tr
#PROXY_PASSWORD=your_password

# ── Option C: IPRoyal ────────────────────────────────────────
# Sign up: https://iproyal.com
# Use residential proxies with Turkey geo-targeting
#PROXY_SERVER=http://geo.iproyal.com:12321
#PROXY_USERNAME=your_username_country-tr
#PROXY_PASSWORD=your_password

# ── Option D: Oxylabs ────────────────────────────────────────
# Sign up: https://oxylabs.io
#PROXY_SERVER=http://pr.oxylabs.io:7777
#PROXY_USERNAME=customer-XXXXX-cc-tr
#PROXY_PASSWORD=your_password

# ── Option E: Any SOCKS5/HTTP proxy ─────────────────────────
# Works with any standard proxy
#PROXY_SERVER=socks5://your-proxy-host:1080
#PROXY_USERNAME=
#PROXY_PASSWORD=
